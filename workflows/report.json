                  {
                      "parameters":  {
                                         "operation":  "executeQuery",
                                         "query":  "SELECT\n  COUNT(*)::integer AS total_notifications,\n\n  COUNT(*) FILTER (\n    WHERE status = \u0027pending\u0027\n  )::integer AS pending_notifications,\n\n  COUNT(*) FILTER (\n    WHERE status = \u0027processing\u0027\n  )::integer AS processing_notifications,\n\n  COUNT(*) FILTER (\n    WHERE status = \u0027sent\u0027\n  )::integer AS sent_notifications,\n\n  COUNT(*) FILTER (\n    WHERE status = \u0027failed\u0027\n  )::integer AS failed_notifications,\n\n  COUNT(*) FILTER (\n    WHERE status = \u0027cancelled\u0027\n  )::integer AS cancelled_notifications,\n\n  COUNT(*) FILTER (\n    WHERE status = \u0027processing\u0027\n      AND leased_until \u003c= NOW()\n  )::integer AS expired_notification_leases,\n\n  COUNT(*) FILTER (\n    WHERE status = \u0027sent\u0027\n      AND kind = \u0027clarification\u0027\n  )::integer AS sent_clarifications,\n\n  COUNT(*) FILTER (\n    WHERE status = \u0027sent\u0027\n      AND kind = \u0027standard_approval\u0027\n  )::integer AS sent_approval_notifications,\n\n  COUNT(*) FILTER (\n    WHERE status = \u0027sent\u0027\n      AND kind = \u0027manual_review\u0027\n  )::integer AS sent_manual_review_notifications\n\nFROM access.notification_outbox;",
                                         "options":  {
